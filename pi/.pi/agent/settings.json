{
  "lastChangelogVersion": "0.82.1",
  "theme": "gruvbox-material",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "off",
  "hideThinkingBlock": false,
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "high",
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "advisor": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "xhigh"
      }
    }
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    {
      "source": "npm:pi-lens",
      "extensions": [
        "+dist/index.js"
      ]
    },
    {
      "source": "npm:pi-subagents",
      "extensions": [
        "-index.ts"
      ],
      "skills": [
        "-skills/pi-subagents/SKILL.md"
      ],
      "prompts": [
        "-prompts/gather-context-and-clarify.md",
        "-prompts/parallel-cleanup.md",
        "-prompts/parallel-context-build.md",
        "-prompts/parallel-handoff-plan.md",
        "-prompts/parallel-research.md",
        "-prompts/parallel-review.md",
        "-prompts/review-loop.md"
      ]
    },
    {
      "source": "npm:@narumitw/pi-goal",
      "extensions": []
    },
    {
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:@juicesharp/rpiv-todo",
    "npm:@tmustier/pi-usage-extension",
    "npm:pi-hermes-memory",
    "npm:pi-rtk-optimizer",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [
        "-dist/extensions/agent-browser/index.js"
      ]
    },
    {
      "source": "npm:@gotgenes/pi-permission-system",
      "extensions": [
        "-src/index.ts"
      ]
    },
    "npm:pi-context"
  ],
  "enableInstallTelemetry": false,
  "quietStartup": false,
  "extensions": [
    "+extensions/footer.ts"
  ],
  "themes": [
    "+themes/gruvbox-material.json"
  ],
  "treeFilterMode": "all",
  "doubleEscapeAction": "tree",
  "defaultProjectTrust": "ask",
  "powerline": "compact"
}